# Copy to .env (never commit .env). Development-only values.
NUA_ENV=development
NUA_DATABASE_URL=postgresql+asyncpg://nua:nua_dev_password@localhost:5432/nua_crew
# Must be replaced with a long random value outside development (the API refuses to start otherwise).
NUA_JWT_SECRET=dev-only-insecure-secret-change-me-32bytes!
# Optional. Enables shared rate limiting across API instances (falls back to in-process).
NUA_REDIS_URL=redis://localhost:6379/0
NUA_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
# Next.js apps (server-side only; never exposed to the browser)
API_BASE_URL=http://localhost:8000
