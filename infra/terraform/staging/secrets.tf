# Secret containers only. Values the owner supplies are entered directly in AWS Secrets Manager and
# never pass through Terraform or the repository. A task that references a secret with no value
# fails to start, which is the intended fail-closed behaviour.
locals {
  owner_supplied_secrets = {
    jwt_secret             = "JWT signing secret: 64 or more random characters, unique to this environment"
    database_url           = "Runtime DSN (postgresql+asyncpg://nua_runtime:...@host/nua_crew?ssl=require). Not the schema owner, not a superuser"
    migration_database_url = "Migration-only DSN (nua_migrator). Injected only into the one-off migration task"
  }
}

resource "aws_secretsmanager_secret" "owner" {
  for_each = local.owner_supplied_secrets

  name                    = "${local.name}/${replace(each.key, "_", "-")}"
  description             = each.value
  kms_key_id              = aws_kms_key.main.arn
  recovery_window_in_days = 7
}

# Generated by Terraform from resources it creates, so the token never needs to be typed. It lives in
# state, which therefore must be encrypted and access-restricted.
resource "aws_secretsmanager_secret" "redis_url" {
  name                    = "${local.name}/redis-url"
  description             = "Redis URL with auth token (rediss://)"
  kms_key_id              = aws_kms_key.main.arn
  recovery_window_in_days = 7
}

resource "aws_secretsmanager_secret_version" "redis_url" {
  secret_id     = aws_secretsmanager_secret.redis_url.id
  secret_string = "rediss://:${random_password.redis.result}@${aws_elasticache_replication_group.main.primary_endpoint_address}:6379/0"
}
